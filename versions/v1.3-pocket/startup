-- Moon BIOS bootloader
-- Installed and maintained by the Moon BIOS Installer.

local ROOT = "/.moonbios"
local MANIFEST = ROOT .. "/manifest"
local BIOS = ROOT .. "/core/bios.lua"

local function stop(message)
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.red)
    term.clear()
    term.setCursorPos(1, 1)
    print("MOON BIOS")
    print()
    print(message)
    print()
    print("Moon BIOS must be installed with the installer.")
    print()
    print("Run:")
    print("  mooninstaller")
    print()
    print("If the installer is missing:")
    print("  wget https://raw.githubusercontent.com/CubeHub-studio/CC-Moon-BIOS/main/installer/installer.lua mooninstaller")
    print("  mooninstaller")
end

if not fs.exists(MANIFEST) or not fs.exists(BIOS) then
    stop("INSTALLATION NOT FOUND")
    return
end

-- The CraftOS shell is provided to programs launched through shell.run.
-- Start the BIOS through shell.run so POST and the boot manager receive the
-- normal CraftOS shell environment instead of loading the BIOS with dofile.
if shell and type(shell.run) == "function" then
    local ok, err = pcall(shell.run, BIOS)
    if not ok then
        stop("MOON BIOS FAILED TO START")
        print(tostring(err))
    end
else
    -- Recovery fallback for non-standard environments.
    local ok, err = pcall(dofile, BIOS)
    if not ok then
        stop("MOON BIOS FAILED TO START")
        print(tostring(err))
    end
end
