-- Moon BIOS secure bootloader
-- Installed and maintained by the Moon BIOS Installer.

local ROOT = "/.moonbios"
local MANIFEST = ROOT .. "/manifest"
local BIOS = ROOT .. "/core/bios.lua"
local VERIFY = ROOT .. "/core/verify.lua"

local function stop(message)
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.red)
    term.clear()
    term.setCursorPos(1, 1)
    print("MOON BIOS SECURE BOOT")
    print()
    print(message)
    print()
    print("Run mooninstaller to repair the installation.")
end

if not fs.exists(MANIFEST) or not fs.exists(BIOS) then
    stop("INSTALLATION NOT FOUND")
    return
end

if not fs.exists(VERIFY) then
    stop("SECURE BOOT VERIFIER NOT FOUND")
    return
end

local ok, verifier = pcall(dofile, VERIFY)
if not ok or type(verifier) ~= "function" then
    stop("SECURE BOOT VERIFIER FAILED TO LOAD")
    return
end

local verified, reason = verifier()
if not verified then
    stop(tostring(reason or "SECURE BOOT INTEGRITY CHECK FAILED"))
    return
end

if shell and type(shell.run) == "function" then
    local started, err = pcall(shell.run, BIOS)
    if not started then
        stop("MOON BIOS FAILED TO START")
        print(tostring(err))
    end
else
    local started, err = pcall(dofile, BIOS)
    if not started then
        stop("MOON BIOS FAILED TO START")
        print(tostring(err))
    end
end
