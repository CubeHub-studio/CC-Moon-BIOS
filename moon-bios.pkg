# Moon BIOS package definition
# CC-PKG package instructions
# Package: moon-bios

name moon-bios
version 1.3.0
type system
entry installer.lua
installer installer/installer.lua

# Moon BIOS must be installed through its installer.
# Do not copy a BIOS payload directly to /startup.
install installer.lua /mooninstaller
run /mooninstaller

# Package metadata and update support.
provides moon-bios
command mooninstaller
command updatemoonbios

# Device-aware installation is handled by the Moon BIOS installer.
device-detect installer
requires http

# The installer owns these paths after installation.
managed /.moonbios
managed /startup
managed /mooninstaller
managed /updatemoonbios
