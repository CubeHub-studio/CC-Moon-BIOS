-- ============================================================
-- POST
-- ============================================================

local function post()
    if not cfg.post then return true end

    clear()
    center(2,"POWER-ON SELF TEST",C.lightBlue)

    local tests={
        {"Computer",function()
            return os.getComputerID()~=nil
        end},

        {"Memory",function()
            local t={}
            for i=1,64 do
                t[i]=string.rep("MOON",256)
            end
            t=nil
            collectgarbage("collect")
            return true
        end},

        {"Filesystem",function()
            local p=".moon_test"
            local f=fs.open(p,"w")
            if not f then return false end
            f.write("OK")
            f.close()

            f=fs.open(p,"r")
            if not f then return false end

            local d=f.readAll()
            f.close()
            fs.delete(p)

            return d=="OK"
        end},

        {"Terminal",function()
            local x,y=term.getCursorPos()
            term.setCursorPos(1,1)
            term.setCursorPos(x,y)
            return true
        end},

        {"Peripherals",function()
            peripheral.getNames()
            return true
        end},

        {"Shell",function()
            return shell and shell.run~=nil
        end}
    }

    local y=4
    local all=true

    for _,t in ipairs(tests) do
        term.setCursorPos(3,y)
        write(t[1])

        local ok,res=pcall(t[2])

        if ok and res then
            term.setTextColor(C.green)
            write("  [ OK ]")
        else
            term.setTextColor(C.red)
            write("  [FAIL]")
            all=false
        end

        y=y+1
    end

    term.setTextColor(all and C.green or C.yellow)
    center(y+1,all and "POST PASSED" or "POST WARNING")

    sleep(1.5)
    return all
end

-- ============================================================
-- SECURE BOOT
-- ============================================================

local function hash(path)
    if not fs.exists(path) or fs.isDir(path) then
        return nil
    end

    local f=fs.open(path,"r")
    if not f then return nil end

    local d=f.readAll()
    f.close()

    local h=2166136261

    for i=1,#d do
        h=bit32.bxor(h,string.byte(d,i))
        h=(h*16777619)%4294967296
    end

    return string.format("%08x",h)
end

local function verify(path)
    if not cfg.secure then
        return true
    end

    local h=hash(path)

    if not h then
        return false
    end

    if not fs.exists(SEC) then
        return not cfg.strict
    end

    local f=fs.open(SEC,"r")
    if not f then
        return false
    end

    local found=false
    local good=false

    for line in f.readAll():gmatch("[^\r\n]+") do
        local p,x=line:match("^(.-)|(.+)$")

        if p==path then
            found=true
            good=x==h
        end
    end

    f.close()

    if not found then
        return not cfg.strict
    end

    return good
end

local function makeSecure()
    local h=hash(cfg.bootFile)

    clear()

    if not h then
        center(5,"BOOT FILE NOT FOUND",C.red)
        pause()
        return
    end

    local f=fs.open(SEC,"w")

    if f then
        f.writeLine(cfg.bootFile.."|"..h)
        f.close()

        center(5,"INTEGRITY RECORD CREATED",C.green)
        center(7,h,C.gray)
    else
        center(5,"FAILED TO CREATE RECORD",C.red)
    end

    pause()
end

