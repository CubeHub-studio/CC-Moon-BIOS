-- MOON BIOS 1.2
-- Complete BIOS / Boot Manager / Recovery Environment
-- ============================================================
--
-- Controls:
--   Arrow Keys = Navigate
--   ENTER      = Select
--   BACKSPACE  = Back
--   1          = BIOS during boot
--   2          = Boot Manager during boot
--   3          = Safe Mode during boot
--
-- Escape is intentionally NOT used anywhere.
-- ============================================================

local VERSION = "1.2"
local BUILD = "Moon BIOS 1.2 Complete"

local CONFIG_FILE = "moonbios.cfg"
local SECURITY_FILE = "moonbios.secure"
local LOG_FILE = "moonbios.log"
local HISTORY_FILE = "moonbios.history"
local ERROR_FILE = "moonbios.errors"

local DEFAULT_BOOT = "bootfile"

local colorsAvailable = type(colors) == "table"

local C = {
    black = colorsAvailable and colors.black or 1,
    white = colorsAvailable and colors.white or 32768,
    gray = colorsAvailable and colors.gray or 128,
    lightGray = colorsAvailable and colors.lightGray or 256,
    blue = colorsAvailable and colors.blue or 2048,
    lightBlue = colorsAvailable and colors.lightBlue or 512,
    cyan = colorsAvailable and colors.cyan or 16,
    green = colorsAvailable and colors.green or 8192,
    lime = colorsAvailable and colors.lime or 32,
    red = colorsAvailable and colors.red or 16384,
    orange = colorsAvailable and colors.orange or 2,
    yellow = colorsAvailable and colors.yellow or 16,
    purple = colorsAvailable and colors.purple or 32
}

local config = {
    bootFile = DEFAULT_BOOT,
    bootDelay = 5,
    autoBoot = true,
    postEnabled = true,
    safeMode = false,
    secureBoot = true,
    secureBootStrict = false,
    passwordEnabled = false,
    password = "",
    theme = "blue",
    bootFailureCount = 0,
    lastBootStatus = "UNKNOWN"
}

local selected = 1
local currentMenu = "main"
local bootInterrupted = false
local bootFailure = false

-- ============================================================
-- BASIC UTILITIES
-- ============================================================

local function now()
    if os.date then
        return os.date("%Y-%m-%d %H:%M:%S")
    end
    return "UNKNOWN"
end

local function safeWriteFile(path, data)
    local ok = pcall(function()
        local f = fs.open(path, "w")
        if f then
            f.write(data)
            f.close()
        end
    end)
    return ok
end

local function safeReadFile(path)
    local result = nil

    pcall(function()
        if fs.exists(path) then
            local f = fs.open(path, "r")
            if f then
                result = f.readAll()
                f.close()
            end
        end
    end)

    return result
end

local function appendFile(path, text)
    pcall(function()
        local f = fs.open(path, "a")
        if f then
            f.writeLine(text)
            f.close()
        end
    end)
end

local function logEvent(text)
    appendFile(LOG_FILE, "[" .. now() .. "] " .. text)
end

local function logError(text)
    appendFile(ERROR_FILE, "[" .. now() .. "] " .. text)
    logEvent("ERROR: " .. text)
end

local function logBoot(text)
    appendFile(HISTORY_FILE, "[" .. now() .. "] " .. text)
end

local function clearScreen(bg)
    term.setBackgroundColor(bg or C.black)
    term.setTextColor(C.white)
    term.clear()
    term.setCursorPos(1, 1)
end

local function getSize()
    return term.getSize()
end

local function centerText(y, text, color)
    local w = getSize()
    local x = math.floor((w - #text) / 2) + 1

    if x < 1 then
        x = 1
    end

    term.setCursorPos(x, y)
    term.setTextColor(color or C.white)
    term.write(text)
end

local function line(y, color)
    local w = getSize()

    term.setCursorPos(1, y)
    term.setTextColor(color or C.lightBlue)
    term.write(string.rep("-", w))
end

local function header(title)
    clearScreen(C.black)

    term.setBackgroundColor(C.lightBlue)
    term.setTextColor(C.white)

    local w = getSize()
    term.setCursorPos(1, 1)
    term.clearLine()

    local x = math.floor((w - #title) / 2) + 1

    if x < 1 then
        x = 1
    end

    term.setCursorPos(x, 1)
    term.write(title)

    term.setBackgroundColor(C.black)
    term.setTextColor(C.white)
end

local function status(text, color)
    local w, h = getSize()

    term.setBackgroundColor(C.black)
    term.setTextColor(color or C.white)

    term.setCursorPos(2, h)
    term.clearLine()
    term.write(text:sub(1, math.max(1, w - 2)))
end

local function pause()
    local w, h = getSize()

    term.setTextColor(C.gray)
    term.setCursorPos(2, h)

    local message = "ENTER = Continue    BACKSPACE = Back"
    term.write(message:sub(1, math.max(1, w - 2)))

    while true do
        local event, key = os.pullEvent("key")

        if key == keys.enter or key == keys.backspace then
            return
        end
    end
end

local function waitEnter()
    while true do
        local event, key = os.pullEvent("key")

        if key == keys.enter then
            return
        end
    end
end

local function yesNo(question)
    header("Moon BIOS - Confirmation")

    centerText(5, question, C.white)
    centerText(7, "[ Y ]  Yes", C.green)
    centerText(8, "[ N ]  No", C.red)

    while true do
        local event, key = os.pullEvent("key")

        if key == keys.y then
            return true
        elseif key == keys.n then
            return false
        end
    end
end

-- ============================================================
-- CONFIGURATION
-- ============================================================

local function serializeConfig()
    local lines = {}

    for key, value in pairs(config) do
        local valueString

        if type(value) == "boolean" then
            valueString = value and "true" or "false"
        else
            valueString = tostring(value)
        end

        lines[#lines + 1] = key .. "=" .. valueString
    end

    table.sort(lines)

    return table.concat(lines, "\n")
end

local function parseValue(value)
    if value == "true" then
        return true
    end

    if value == "false" then
        return false
    end

    local number = tonumber(value)

    if number ~= nil then
        return number
    end

    return value
end

local function loadConfig()
    if not fs.exists(CONFIG_FILE) then
        safeWriteFile(CONFIG_FILE, serializeConfig())
        return
    end

    local data = safeReadFile(CONFIG_FILE)

    if not data then
        return
    end

    for lineText in string.gmatch(data, "[^\r\n]+") do
        local key, value = lineText:match("^([^=]+)=(.*)$")

        if key and value and config[key] ~= nil then
            config[key] = parseValue(value)
        end
    end

    if type(config.bootDelay) ~= "number" then
        config.bootDelay = 5
    end

    if config.bootDelay < 0 then
        config.bootDelay = 0
    end

    if config.bootDelay > 30 then
        config.bootDelay = 30
    end

    if type(config.bootFile) ~= "string" or config.bootFile == "" then
        config.bootFile = DEFAULT_BOOT
    end
end

local function saveConfig()
    safeWriteFile(CONFIG_FILE, serializeConfig())
    logEvent("BIOS configuration saved")
end

local function resetConfig()
    config.bootFile = DEFAULT_BOOT
    config.bootDelay = 5
    config.autoBoot = true
    config.postEnabled = true
    config.safeMode = false
    config.secureBoot = true
    config.secureBootStrict = false
    config.passwordEnabled = false
    config.password = ""
    config.theme = "blue"
    config.bootFailureCount = 0
    config.lastBootStatus = "RESET"

    saveConfig()
end

-- ============================================================
-- PASSWORD
-- ============================================================

local function passwordCheck()
    if not config.passwordEnabled then
        return true
    end

    header("Moon BIOS - Password")

    centerText(4, "BIOS password required", C.yellow)
    centerText(6, "Enter password:", C.white)

    term.setCursorPos(2, 8)
    term.setTextColor(C.white)

    local typed = read("*")

    if typed == config.password then
        return true
    end

    header("Moon BIOS - Access Denied")
    centerText(6, "Incorrect password.", C.red)
    sleep(1.5)

    logError("BIOS password authentication failed")

    return false
end

local function setPassword()
    header("Moon BIOS - Password")

    centerText(4, "Set BIOS Password", C.lightBlue)
    centerText(6, "Leave blank to disable password.", C.gray)

    term.setCursorPos(2, 8)
    term.setTextColor(C.white)

    local first = read("*")

    if first == "" then
        config.passwordEnabled = false
        config.password = ""

        saveConfig()

        centerText(10, "Password disabled.", C.green)
        sleep(1)
        return
    end

    centerText(10, "Confirm password:", C.white)

    term.setCursorPos(2, 12)
    local second = read("*")

    if first ~= second then
        centerText(15, "Passwords do not match.", C.red)
        sleep(1.5)
        return
    end

    config.password = first
    config.passwordEnabled = true

    saveConfig()

    centerText(15, "Password enabled.", C.green)
    sleep(1.5)
end

