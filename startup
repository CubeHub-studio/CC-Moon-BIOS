-- ============================================================

local function graphicsAvailable()
    if type(term.setGraphicsMode) ~= "function" then
        return false
    end

    local oldMode = nil

    pcall(function()
        if type(term.getGraphicsMode) == "function" then
            oldMode = term.getGraphicsMode()
        end
    end)

    local ok = pcall(function()
        term.setGraphicsMode(0)
    end)

    if oldMode ~= nil then
        pcall(function()
            term.setGraphicsMode(oldMode)
        end)
    end

    return ok
end

local function getGraphicsDimensions()
    if not graphicsAvailable() then
        return nil, nil
    end

    local w, h

    pcall(function()
        if type(term.getSize) == "function" then
            w, h = term.getSize(2)
        end
    end)

    return w, h
end

local function detectCCSecureBoot()
    return fs.exists("/rom/modules/main/codesign.lua")
end

local function detectPeripherals()
    local result = {}

    if type(peripheral) ~= "table" then
        return result
    end

    local names = peripheral.getNames()

    for _, name in ipairs(names) do
        local types = peripheral.getType(name)

        if type(types) == "table" then
            result[#result + 1] = name .. " [" .. table.concat(types, ", ") .. "]"
        else
            result[#result + 1] = name .. " [" .. tostring(types) .. "]"
        end
    end

    return result
end

local function hardwareDetection()
    header("Moon BIOS - Hardware Detection")

    local w, h = getSize()
    local y = 3

    local function printItem(name, value)
        if y >= h - 2 then
            waitEnter()

            header("Moon BIOS - Hardware Detection")
            y = 3
        end

        term.setCursorPos(2, y)
        term.setTextColor(C.lightBlue)
        term.write(name .. ": ")

        term.setTextColor(C.white)
        term.write(tostring(value))

        y = y + 1
    end

    printItem("Computer ID", os.getComputerID())

    local label = os.getComputerLabel()

    if label == nil then
        label = "Not set"
    end

    printItem("Computer Label", label)
    printItem("Computer Type", tostring(os.computerLabel and "Computer" or "Unknown"))
    printItem("Terminal Width", w)
    printItem("Terminal Height", h)
    printItem("Graphics API", graphicsAvailable() and "Available" or "Unavailable")

    local gw, gh = getGraphicsDimensions()

    if gw and gh then
        printItem("Graphics Width", gw)
        printItem("Graphics Height", gh)
    end

    printItem("CCSecureBoot", detectCCSecureBoot() and "Detected" or "Not detected")

    local peripherals = detectPeripherals()

    printItem("Peripheral Count", #peripherals)

    for _, peripheralName in ipairs(peripherals) do
        printItem("Peripheral", peripheralName)
    end

    printItem("BIOS Version", VERSION)
    printItem("Build", BUILD)

    pause()
end

