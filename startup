-- ============================================================
-- SCREEN FUNCTIONS
-- ============================================================

local function bootBackground()
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.white)
    term.clear()
    term.setCursorPos(1, 1)
end

local function biosBackground()
    term.setBackgroundColor(colors.lightBlue)
    term.setTextColor(colors.white)
    term.clear()
    term.setCursorPos(1, 1)
end

local function pause(message)
    print()
    print(message or "Press any key to continue.")

    while true do
        local event = os.pullEvent()

        if event == "key" then
            return
        end
    end
end

local function trim(text)
    if not text then
        return ""
    end

    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")

    return text
end

local function boolText(value)
    if value then
        return "Enabled"
    end

    return "Disabled"
end

local function clamp(value, minimum, maximum)
    if value < minimum then
        return minimum
    end

    if value > maximum then
        return maximum
    end

    return value
end

-- ============================================================
-- FILE FUNCTIONS
-- ============================================================

local function readFile(path)
    if not fs.exists(path) then
        return nil
    end

    if fs.isDir(path) then
        return nil
    end

    local handle = fs.open(path, "r")

    if not handle then
        return nil
    end

    local data = handle.readAll()

    handle.close()

    return data
end

local function writeFile(path, data)
    local handle = fs.open(path, "w")

    if not handle then
        return false
    end

    handle.write(data)
    handle.close()

    return true
end

-- ============================================================
-- SETTINGS
-- ============================================================

local function saveSettings()
    local data = {
        version = VERSION,
        bootFile = bootFile,
        bootDelay = bootDelay,
        autoBoot = autoBoot,
        postEnabled = postEnabled,
        safeMode = safeMode,
        secureBoot = secureBoot,
        secureBootStrict = secureBootStrict
    }

    local ok, serialized = pcall(
        textutils.serialise,
        data
    )

    if not ok then
        return false
    end

    return writeFile(
        CONFIG_FILE,
        serialized
    )
end

local function loadSettings()
    if not fs.exists(CONFIG_FILE) then
        saveSettings()
        return
    end

    local data = readFile(CONFIG_FILE)

    if not data or data == "" then
        return
    end

    local ok, settingsData = pcall(
        textutils.unserialise,
        data
    )

    if not ok then
        return
    end

    if type(settingsData) ~= "table" then
        return
    end

    if type(settingsData.bootFile) == "string" then
        if settingsData.bootFile ~= "" then
            bootFile = settingsData.bootFile
        end
    end

    if type(settingsData.bootDelay) == "number" then
        bootDelay = clamp(
            math.floor(settingsData.bootDelay),
            0,
            30
        )
    end

    if type(settingsData.autoBoot) == "boolean" then
        autoBoot = settingsData.autoBoot
    end

    if type(settingsData.postEnabled) == "boolean" then
        postEnabled = settingsData.postEnabled
    end

    if type(settingsData.safeMode) == "boolean" then
        safeMode = settingsData.safeMode
    end

    if type(settingsData.secureBoot) == "boolean" then
        secureBoot = settingsData.secureBoot
    end

    if type(settingsData.secureBootStrict) == "boolean" then
        secureBootStrict = settingsData.secureBootStrict
    end
end

-- ============================================================
-- INTEGRITY CHECK
-- ============================================================

local function calculateDigest(text)
    local h1 = 2166136261
    local h2 = 16777619

    for i = 1, #text do
        local byte = string.byte(text, i)

        h1 = bit32.bxor(h1, byte)
        h1 = (h1 * 16777619) % 4294967296

        h2 = bit32.bxor(
            h2,
            (byte + i) % 256
        )

        h2 = (h2 * 2246822519) % 4294967296
    end

    return string.format(
        "%08x%08x",
        h1,
        h2
    )
end

local function hasIntegrityRecord()
    return fs.exists(INTEGRITY_FILE)
end

local function createIntegrityRecord(path)
    local source = readFile(path)

    if not source then
        return false
    end

    local hash = calculateDigest(source)

    return writeFile(
        INTEGRITY_FILE,
        hash
    )
end

local function verifyLocalIntegrity(path)
    if not fs.exists(INTEGRITY_FILE) then
        return false,
            "No integrity record exists."
    end

    local expected = readFile(
        INTEGRITY_FILE
    )

    if not expected then
        return false,
            "Unable to read integrity record."
    end

    expected = trim(expected)

    if expected == "" then
        return false,
            "Integrity record is empty."
    end

    local source = readFile(path)

    if not source then
        return false,
            "Unable to read boot file."
    end

    local actual = calculateDigest(source)

    if actual == expected then
        return true,
            "Integrity check passed."
    end

    return false,
        "Integrity check FAILED."
end

-- ============================================================
-- SECURE BOOT DETECTION
-- ============================================================

local function hasCCSecureBoot()
    return fs.exists(
        "/rom/modules/main/codesign.lua"
    )
end

local function verifySecureBoot(path)
    if not secureBoot then
        return true,
            "Secure Boot disabled."
    end

    -- Real CCSecureBoot integration
    if hasCCSecureBoot() then
        local ok, module = pcall(
            dofile,
            "/rom/modules/main/codesign.lua"
        )

        if ok and type(module) == "table" then
            if type(module.verify) == "function" then

                local verified, result = pcall(
                    module.verify,
                    path
                )

                if verified and result then
                    return true,
                        "CCSecureBoot signature verified."
                end

                return false,
                    "CCSecureBoot signature verification failed."
            end
        end

        return false,
            "CCSecureBoot verification module failed."
    end

    -- Moon BIOS local integrity fallback
    local valid, message =
        verifyLocalIntegrity(path)

    if valid then
        return true, message
    end

    if secureBootStrict then
        return false,
            "Strict Secure Boot requires a valid integrity record."
    end

    return false, message
end

