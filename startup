    if fs.exists(config.bootFile) then
        centerText(6, "Boot file already exists.", C.green)
        pause()
        return
    end

    local candidates = {
        "startup",
        "boot.lua",
        "boot"
    }

    local found = nil

    for _, path in ipairs(candidates) do
        if fs.exists(path) and not fs.isDir(path) then
            found = path
            break
        end
    end

    if found then
        local ok = pcall(function()
            fs.copy(found, config.bootFile)
        end)

        if ok then
            centerText(6, "Recovered: " .. found, C.green)
            centerText(8, "Created: " .. config.bootFile, C.green)

            writeLog("Recovered boot file from " .. found)
        else
            centerText(6, "Repair failed.", C.red)
        end
    else
        centerText(6, "No recovery boot file found.", C.yellow)
    end

    pause()
end

