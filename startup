local function logo()
    clearScreen(C.black)

    local moon = {
        "             ######",
        "           #######",
        "        #########",
        "      #########",
        "     ########",
        "    #######",
        "    #####",
        "     #######",
        "      ########",
        "       ########",
        "        #########",
        "           #######",
        "             ######"
    }

    local _, h = getSize()

    local startY = math.floor((h - #moon) / 2) - 1

    if startY < 2 then
