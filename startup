local function fileSize(path)
    local size = 0

    pcall(function()
        if not fs.isDir(path) then
            local data = safeReadFile(path)

            if data then
                size = #data
            end
        end
    end)

    return size
end

local function fileViewer(path)
    if not fs.exists(path) then
        header("Moon BIOS - File Viewer")
        centerText(6, "File not found.", C.red)
        pause()
        return
    end

    if fs.isDir(path) then
        header("Moon BIOS - File Viewer")
        centerText(6, "Cannot view a directory.", C.red)
        pause()
        return
    end

    local data = safeReadFile(path)

    if not data then
        header("Moon BIOS - File Viewer")
        centerText(6, "Unable to read file.", C.red)
        pause()
        return
    end

    local lines = {}

    for textLine in string.gmatch(data, "[^\r\n]*") do
        lines[#lines + 1] = textLine
    end

    local offset = 1

    while true do
        header("Moon BIOS - File Viewer")

        local w, h = getSize()

        term.setCursorPos(2, 2)
        term.setTextColor(C.gray)
        term.write(path)

        for i = 1, h - 5 do
            local index = offset + i - 1
            local textLine = lines[index]

            if textLine then
                term.setCursorPos(2, i + 3)
                term.setTextColor(C.white)
                term.write(textLine:sub(1, w - 3))
            end
        end

        status("UP/DOWN Scroll    BACKSPACE Back")

        local event, key = os.pullEvent("key")

        if key == keys.up then
            if offset > 1 then
                offset = offset - 1
            end
        elseif key == keys.down then
            if offset < #lines then
                offset = offset + 1
            end
        elseif key == keys.backspace then
            return
        end
    end
end

local function fileManager()
    local path = "/"
    local index = 1

    while true do
        header("Moon BIOS - File Manager")

        local entries = fs.list(path)
        table.sort(entries)

        if #entries == 0 then
            centerText(6, "(empty)", C.gray)
        end

        local _, h = getSize()

        if index < 1 then
            index = 1
        end

        if index > #entries then
            index = #entries
        end

        local visible = math.max(1, h - 7)

        local start = 1

        if index > visible then
            start = index - visible + 1
        end

        for i = start, math.min(#entries, start + visible - 1) do
            local y = 3 + (i - start)

            local name = entries[i]
            local full = fs.combine(path, name)

            term.setCursorPos(2, y)

            if i == index then
                term.setBackgroundColor(C.lightBlue)
                term.setTextColor(C.white)
            else
                term.setBackgroundColor(C.black)
                term.setTextColor(C.white)
            end

            local suffix = ""

            if fs.isDir(full) then
                suffix = "/"
            else
                suffix = " (" .. tostring(fileSize(full)) .. " B)"
            end

            term.clearLine()
            term.write(name .. suffix)

            term.setBackgroundColor(C.black)
        end

        status("ENTER Open    D Delete    R Rename    N New Folder    BACKSPACE Back")

        local event, key = os.pullEvent("key")

        if key == keys.up then
            if #entries > 0 then
                index = index - 1

                if index < 1 then
                    index = #entries
                end
            end

        elseif key == keys.down then
            if #entries > 0 then
                index = index + 1

                if index > #entries then
                    index = 1
                end
            end

        elseif key == keys.enter then
            if #entries > 0 then
                local name = entries[index]
                local full = fs.combine(path, name)

                if fs.isDir(full) then
                    path = full
                    index = 1
                else
                    fileViewer(full)
                end
            end

        elseif key == keys.backspace then
            if path == "/" then
                return
            end

            path = fs.getDir(path)

            if path == "" then
                path = "/"
            end

            index = 1

        elseif key == keys.d then
            if #entries > 0 then
                local full = fs.combine(path, entries[index])

                if yesNo("Delete " .. entries[index] .. "?") then
                    pcall(function()
                        fs.delete(full)
                    end)

                    logEvent("Deleted " .. full)
                end
            end

        elseif key == keys.r then
            if #entries > 0 then
                local oldName = entries[index]

                header("Moon BIOS - Rename")

                centerText(4, "Current: " .. oldName, C.white)
                centerText(6, "New name:", C.lightBlue)

                term.setCursorPos(2, 8)
                local newName = read()

                if newName ~= "" then
                    local oldPath = fs.combine(path, oldName)
                    local newPath = fs.combine(path, newName)

                    if not fs.exists(newPath) then
                        pcall(function()
                            fs.move(oldPath, newPath)
                        end)

                        logEvent("Renamed " .. oldPath .. " to " .. newPath)
                    end
                end
            end

        elseif key == keys.n then
            header("Moon BIOS - New Folder")

            centerText(5, "Folder name:", C.lightBlue)

            term.setCursorPos(2, 7)
            local folder = read()

            if folder ~= "" then
                local newPath = fs.combine(path, folder)

                if not fs.exists(newPath) then
                    pcall(function()
                        fs.makeDir(newPath)
                    end)

                    logEvent("Created directory " .. newPath)
                end
            end
        end
    end
end

-- ============================================================
-- BOOT FILE SCANNER
-- ============================================================

local function scanBootFiles()
    local result = {}

    local entries = fs.list("/")

    for _, name in ipairs(entries) do
        local path = "/" .. name

        if not fs.isDir(path) then
            if name == "bootfile"
                or name:match("^boot")
                or name:match("^startup")
                or name:match("^moon")
                or name:match("%.lua$") then

                result[#result + 1] = path
            end
        end
    end

    table.sort(result)

    return result
end

local function bootManager()
    local files = scanBootFiles()

    if #files == 0 then
        header("Moon BIOS - Boot Manager")
        centerText(6, "No bootable files detected.", C.red)
        pause()
        return
    end

    local index = 1

    for i, path in ipairs(files) do
        if path == config.bootFile then
            index = i
        end
    end

    while true do
        header("Moon BIOS - Boot Manager")

        local _, h = getSize()
        local visible = math.max(1, h - 7)

        local start = 1

        if index > visible then
            start = index - visible + 1
        end

        for i = start, math.min(#files, start + visible - 1) do
            local y = 3 + i - start

            term.setCursorPos(2, y)

            if i == index then
                term.setBackgroundColor(C.lightBlue)
                term.setTextColor(C.white)
            else
                term.setBackgroundColor(C.black)
                term.setTextColor(C.white)
            end

            term.clearLine()

            local marker = ""

            if files[i] == config.bootFile then
                marker = " [DEFAULT]"
            end

            term.write(files[i] .. marker)
            term.setBackgroundColor(C.black)
        end

        status("ENTER Boot    S Set Default    D Delete    BACKSPACE Back")

        local event, key = os.pullEvent("key")

        if key == keys.up then
            index = index - 1

            if index < 1 then
                index = #files
            end

        elseif key == keys.down then
            index = index + 1

            if index > #files then
                index = 1
            end

        elseif key == keys.enter then
            local selectedFile = files[index]

            if secureBootScreen(selectedFile) then
                local ok = pcall(function()
                    shell.run(selectedFile)
                end)

                if not ok then
                    logError("Boot Manager failed to execute " .. selectedFile)
                end
            end

            return

        elseif key == keys.s then
            config.bootFile = files[index]
            saveConfig()

        elseif key == keys.d then
            local selectedFile = files[index]

            if selectedFile ~= "/startup" and selectedFile ~= "/bootfile" then
                if yesNo("Delete " .. selectedFile .. "?") then
                    pcall(function()
                        fs.delete(selectedFile)
                    end)

                    logEvent("Boot Manager deleted " .. selectedFile)

                    files = scanBootFiles()

                    if #files == 0 then
                        return
                    end

                    if index > #files then
                        index = #files
                    end
                end
            end

        elseif key == keys.backspace then
            return
        end
    end
end

