-- ============================================================
-- BOOT COUNTDOWN
-- ============================================================

local function countdown()
    if cfg.bootDelay<=0 then return "boot" end

    local left=cfg.bootDelay
    local timer=os.startTimer(1)

    while left>0 do
        clear()

        local moon={
            "             ######",
            "           #######",
            "        #########",
            "      #########",
            "     ########",
            "    #######",
            "    #####",
            "     #######",
            "      ########",
            "       ########",
            "        #########",
            "           #######",
            "             ######"
        }

        local _,h=term.getSize()
        local y=math.max(1,math.floor((h-#moon)/2)-2)

        for i,row in ipairs(moon) do
            center(y+i,row,C.lightBlue)
        end

        center(y+#moon+2,"MOON BIOS",C.white)
        center(y+#moon+4,
            "Booting "..cfg.bootFile.." in "..left,
            C.white
        )

        center(y+#moon+6,
            "1 BIOS   2 Boot Manager   3 Safe Mode",
            C.gray
        )

        local e,k=os.pullEvent()

        if e=="key" then
            if k==keys.one then return "bios" end
            if k==keys.two then return "manager" end
            if k==keys.three then return "safe" end

        elseif e=="timer" and k==timer then
            left=left-1

            if left>0 then
                timer=os.startTimer(1)
            end
        end
    end

    return "boot"
end

-- ============================================================
-- START
-- ============================================================

load()
log("Moon BIOS started.")

logo()

post()

if cfg.safe then
    safeMode()
    return
end

local choice=countdown()

if choice=="bios" then
    menu()

elseif choice=="manager" then
    bootManager()

elseif choice=="safe" then
    safeMode()

else
    if cfg.autoBoot and fs.exists(cfg.bootFile) then
        if verify(cfg.bootFile) then
            local ok=pcall(function()
                shell.run(cfg.bootFile)
            end)

            if not ok then
                clear()
                center(5,"BOOT FAILED",C.red)
                pause()
                menu()
            end
        else
            clear()
            center(5,"SECURE BOOT BLOCKED",C.red)
            center(7,cfg.bootFile,C.white)
            pause()
            menu()
        end
    else
        menu()
    end
end
