    logo()

    -- POST
    if postEnabled then
        sleep(0.25)
        post()
    end

    -- ========================================================
    -- MISSING BOOT FILE
    -- ========================================================

    if not fs.exists(bootFile) then

        sleep(0.5)

        bios()

        return
    end

    -- ========================================================
    -- AUTO BOOT DISABLED
    -- ========================================================

    if not autoBoot then

        bios()

        return
    end

    -- ========================================================
    -- HIDDEN BOOT TIMER
    -- ========================================================

    local timer =
        os.startTimer(bootDelay)

    while true do

        local event, parameter =
            os.pullEvent()

        if event == "key" then

            -- BIOS
            if parameter == keys.one then

                os.cancelTimer(timer)

                bios()

                return
            end

            -- Boot Manager
            if parameter == keys.two then

                os.cancelTimer(timer)

                bootManager()

                return
            end

            -- Safe Mode
            if parameter == keys.three then

                os.cancelTimer(timer)

                local oldSafeMode =
                    safeMode

                safeMode = true

                runBootFile(bootFile)

                safeMode = oldSafeMode

                bios()

                return
            end
        end

        if event == "timer"
            and parameter == timer then

            break
        end
    end

    -- ========================================================
    -- AUTOMATIC BOOT
    -- ========================================================

    local success =
        runBootFile(bootFile)

    if success then

        bios()

    else

        recoveryMenu()
    end
end

