-- ============================================================
-- STARTUP
-- ============================================================

loadConfig()

writeLog("========================================")
writeLog("Moon BIOS starting.")
writeLog("Version: " .. VERSION)

logo()

local postPassed = true

if config.postEnabled then
    postPassed = runPOST()
end

if config.safeMode then
    safeMode()
    return
end

local bootChoice = bootCountdown()

if bootChoice == "bios" then
    mainMenu()

elseif bootChoice == "manager" then
    bootManager()

elseif bootChoice == "safe" then
    safeMode()

elseif bootChoice == "boot" then
    if config.autoBoot then
        local ok, message = attemptBoot()

        if not ok then
            bootError(message)
            mainMenu()
        end
    else
        mainMenu()
    end
end
