local function viewLog(path, title)
    local data = safeReadFile(path)

    header("Moon BIOS - " .. title)

    if not data or data == "" then
        centerText(6, "No log entries.", C.gray)
        pause()
        return
    end

    local lines = {}

    for textLine in string.gmatch(data, "[^\r\n]+") do
        lines[#lines + 1] = textLine
    end

    local offset = math.max(1, #lines - 10)

    while true do
        header("Moon BIOS - " .. title)

        local _, h = getSize()

        for i = 1, h - 5 do
            local index = offset + i - 1

            if lines[index] then
                term.setCursorPos(2, i + 2)
                term.setTextColor(C.white)
                term.write(lines[index])
            end
        end

        status("UP/DOWN Scroll    BACKSPACE Back")

        local event, key = os.pullEvent("key")

        if key == keys.up then
            if offset > 1 then
                offset = offset - 1
            end

        elseif key == keys.down then
            if offset < #lines then
                offset = offset + 1
            end

        elseif key == keys.backspace then
            return
        end
    end
end

