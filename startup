local function testMemory()
    local ok = pcall(function()
        local memoryTest = {}

        for i = 1, 128 do
            memoryTest[i] = string.rep("MOON", 512)
        end

        if #memoryTest ~= 128 then
            error("Memory allocation failure")
        end

        memoryTest = nil

        if type(collectgarbage) == "function" then
            collectgarbage("collect")
        end
    end)

    return ok
end

local function testFilesystem()
    local testFile = ".moonbios_test"

    local ok = pcall(function()
        local f = fs.open(testFile, "w")

        if not f then
            error("Unable to create test file")
        end

        f.write("MOON BIOS")
        f.close()

        if not fs.exists(testFile) then
            error("Test file missing")
        end

        fs.delete(testFile)
    end)

    pcall(function()
        if fs.exists(testFile) then
            fs.delete(testFile)
        end
    end)

    return ok
end

local function testTerminal()
    return pcall(function()
        local w, h = term.getSize()

        if not w or not h then
            error("Terminal dimensions unavailable")
        end

        if w < 1 or h < 1 then
            error("Invalid terminal dimensions")
        end
    end)
end

local function testPeripherals()
    return pcall(function()
        if peripheral and peripheral.getNames then
            peripheral.getNames()
        end
    end)
end

local function testEvents()
    return pcall(function()
        if type(os.pullEventRaw) ~= "function" then
            error("Event API unavailable")
        end
    end)
end

local function testShell()
    return type(shell) == "table" and type(shell.run) == "function"
end

local function testGraphics()
    return graphicsAvailable()
end

local function testSecureBootAPI()
    return detectCCSecureBoot()
end

local function runPOST()
    header("Moon BIOS - POST")

    centerText(3, "Power-On Self Test", C.lightBlue)
    centerText(4, "Testing system hardware...", C.gray)

    local tests = {
        {"CPU", testCPU},
        {"Memory", testMemory},
        {"Filesystem", testFilesystem},
        {"Terminal", testTerminal},
        {"Peripherals", testPeripherals},
        {"Event System", testEvents},
        {"Shell", testShell},
        {"CC: Graphics", testGraphics},
        {"Secure Boot API", testSecureBootAPI}
    }

    local results = {}
    local failures = 0

    for i, test in ipairs(tests) do
        local name = test[1]
        local fn = test[2]

        local ok = false

        local success, result = pcall(fn)

        if success and result then
            ok = true
        end

        results[#results + 1] = {
            name = name,
            ok = ok
        }

        if not ok then
            failures = failures + 1
        end

        local y = 6 + i

        term.setCursorPos(3, y)
        term.setTextColor(C.white)
        term.write(name)

        term.setCursorPos(24, y)

        if ok then
            term.setTextColor(C.green)
            term.write("[ PASS ]")
        else
            term.setTextColor(C.red)
            term.write("[ FAIL ]")
        end
    end

    term.setCursorPos(3, 17)
    term.setTextColor(C.white)
    term.write("POST Result: ")

    if failures == 0 then
        term.setTextColor(C.green)
        term.write("PASS")
        logEvent("POST completed successfully")
    else
        term.setTextColor(C.red)
        term.write(tostring(failures) .. " FAILURE(S)")
        logError("POST completed with failures: " .. tostring(failures))
    end

    sleep(1.5)

    return failures == 0, results
end

-- ============================================================
-- SECURE BOOT
-- ============================================================

local function calculateSimpleIntegrity(path)
    if not fs.exists(path) or fs.isDir(path) then
        return nil
    end

    local data = safeReadFile(path)

    if not data then
        return nil
    end

    local hash = 2166136261

    for i = 1, #data do
        hash = (hash * string.byte(data, i)) % 4294967296
        hash = (hash * 16777619) % 4294967296
    end

    return string.format("%08x", hash)
end

local function secureBootVerify(path)
    if not fs.exists(path) then
        return false, "File does not exist"
    end

    if fs.isDir(path) then
        return false, "Path is a directory"
    end

    if not config.secureBoot then
        return true, "Secure Boot disabled"
    end

    if detectCCSecureBoot() then
        local ok, codesign = pcall(function()
            return dofile("/rom/modules/main/codesign.lua")
        end)

        if ok and codesign and type(codesign.verify) == "function" then
            local verified, result = pcall(function()
                return codesign.verify(path)
            end)

            if verified and result then
                return true, "CCSecureBoot verification passed"
            end

            if config.secureBootStrict then
                return false, "CCSecureBoot verification failed"
            end

            return true, "CCSecureBoot verification failed; strict mode disabled"
        end

        if config.secureBootStrict then
            return false, "CCSecureBoot API unavailable"
        end
    end

    local integrity = calculateSimpleIntegrity(path)

    if not integrity then
        if config.secureBootStrict then
            return false, "Unable to calculate integrity"
        end

        return true, "Integrity unavailable; strict mode disabled"
    end

    local secureData = safeReadFile(SECURITY_FILE)

    if secureData then
        local stored = secureData:match("^" .. path:gsub("([^%w])", "%%%1") .. "=(%x+)")

        if stored then
            if stored == integrity then
                return true, "Local integrity verification passed"
            end

            if config.secureBootStrict then
                return false, "Integrity mismatch"
            end

            return true, "Integrity mismatch; strict mode disabled"
        end
    end

    if config.secureBootStrict then
        return false, "No trusted integrity record"
    end

    return true, "No trusted record; strict mode disabled"
end

local function secureBootScreen(path)
    header("Moon BIOS - Secure Boot")

    centerText(4, "Verifying boot file...", C.lightBlue)
    centerText(6, path, C.white)

    local ok, message = secureBootVerify(path)

    if ok then
        centerText(9, "VERIFIED", C.green)
        centerText(11, message, C.gray)
        logEvent("Secure Boot: " .. path .. " - " .. message)
    else
        centerText(9, "VERIFICATION FAILED", C.red)
        centerText(11, message, C.red)
        logError("Secure Boot rejected " .. path .. ": " .. message)
    end

    sleep(1.5)

    return ok
end

local function createIntegrityRecord()
    header("Moon BIOS - Security")

    local bootFile = config.bootFile

    if not fs.exists(bootFile) then
        centerText(6, "Boot file does not exist.", C.red)
        pause()
        return
    end

    local hash = calculateSimpleIntegrity(bootFile)

    if not hash then
        centerText(6, "Unable to calculate integrity.", C.red)
        pause()
        return
    end

    safeWriteFile(SECURITY_FILE, bootFile .. "=" .. hash .. "\n")

    centerText(6, "Integrity record created.", C.green)
    centerText(8, "File: " .. bootFile, C.white)
    centerText(9, "Digest: " .. hash, C.gray)

    logEvent("Created local integrity record for " .. bootFile)

    pause()
end

