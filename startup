-- ============================================================
-- BOOT COUNTDOWN
-- ============================================================

local function bootCountdown()
    if config.bootDelay <= 0 then
        return "boot"
    end

    local remaining = config.bootDelay
    local timer = os.startTimer(1)

    while remaining > 0 do
        clearScreen(C.black)

        local moon = {
            "             ######",
            "           #######",
            "        #########",
            "      #########",
            "     ########",
            "    #######",
            "    #####",
            "     #######",
            "      ########",
            "       ########",
            "        #########",
            "           #######",
            "             ######"
        }

        local _, h = getSize()
        local startY = math.floor((h - #moon) / 2) - 2

        if startY < 1 then
            startY = 1
        end

        for i, row in ipairs(moon) do
            centerText(startY + i, row, C.lightBlue)
        end

        centerText(startY + #moon + 2, "MOON BIOS", C.white)
        centerText(startY + #moon + 3, VERSION, C.gray)

        centerText(startY + #moon + 5,
            "Booting " .. config.bootFile .. " in " .. tostring(remaining),
            C.white
        )

        centerText(startY + #moon + 7,
            "1 BIOS    2 Boot Manager    3 Safe Mode",
            C.gray
        )

        local event, value = os.pullEvent()

        if event == "key" then
            if value == keys.one then
                return "bios"

            elseif value == keys.two then
                return "manager"

            elseif value == keys.three then
                return "safe"
            end

        elseif event == "timer" and value == timer then
            remaining = remaining - 1

            if remaining > 0 then
                timer = os.startTimer(1)
            end
        end
    end

    return "boot"
end

-- ============================================================
-- BOOT
-- ============================================================

local function attemptBoot()
    local path = config.bootFile

    if type(path) ~= "string" or path == "" then
        path = BOOT_FILE
    end

    if not fs.exists(path) then
        writeLog("Boot failed: " .. path .. " does not exist.")
        writeHistory("FAILED - missing boot file: " .. path)

        return false, "Boot file not found: " .. path
    end

    if fs.isDir(path) then
        writeLog("Boot failed: " .. path .. " is a directory.")
        writeHistory("FAILED - boot target is directory: " .. path)

        return false, "Boot target is a directory."
    end

    if config.secureBoot then
        local secureOK, secureMessage = secureBootVerify(path)

        if not secureOK then
            writeLog("Secure Boot blocked " .. path .. ": " .. secureMessage)
            writeHistory("BLOCKED - Secure Boot: " .. path)

            return false, secureMessage
        end

        writeLog("Secure Boot passed for " .. path)
    end

    writeLog("Attempting to boot " .. path)
    writeHistory("BOOT - " .. path)

    local ok, result = pcall(function()
        return shell.run(path)
    end)

    if not ok then
        writeLog("Boot crashed: " .. tostring(result))
        writeHistory("CRASH - " .. path)

        return false, tostring(result)
    end

    if result == false then
        writeLog("Boot command returned failure.")
        writeHistory("FAILED - " .. path)

        return false, "The boot program returned an error."
    end

    writeLog("Boot completed.")
    writeHistory("SUCCESS - " .. path)

    return true
end

