-- ============================================================
-- BOOT MANAGER
-- ============================================================

local function findBootFiles()
    local files = {}

    local list = fs.list("/")

    for _, name in ipairs(list) do
        if not fs.isDir(name) then
            local lower = string.lower(name)

            if lower == "bootfile"
                or lower == "startup"
                or lower:match("^boot")
                or lower:match("%.boot$")
                or lower:match("%.lua$") then

                files[#files + 1] = name
            end
        end
    end

    table.sort(files)

    return files
end

local function bootManager()
    while true do
        clearScreen(C.black)

        centerText(2, "MOON BOOT MANAGER", C.lightBlue)
        separator(3)

        local files = findBootFiles()

        if #files == 0 then
            term.setCursorPos(3, 6)
            safeText(C.yellow)
            write("No boot files were detected.")

            term.setCursorPos(3, 8)
            safeText(C.gray)
            write("Backspace = Return")

            while true do
                local event, key = os.pullEvent("key")

                if key == keys.backspace then
                    return
                end
            end
        end

        local selected = 1

        while true do
            clearScreen(C.black)

            centerText(2, "MOON BOOT MANAGER", C.lightBlue)
            separator(3)

            for i, fileName in ipairs(files) do
                local y = 5 + i

                if y < getSize() - 2 then
                    term.setCursorPos(4, y)

                    if i == selected then
                        safeText(C.lime)
                        write("> " .. fileName)
                    else
                        safeText(C.white)
                        write("  " .. fileName)
                    end
                end
            end

            local _, h = getSize()

            term.setCursorPos(3, h - 1)
            safeText(C.gray)
            write("ENTER=Boot  BACKSPACE=Back")

            local event, key = os.pullEvent("key")

            if key == keys.up then
                selected = selected - 1

                if selected < 1 then
                    selected = #files
                end

            elseif key == keys.down then
                selected = selected + 1

                if selected > #files then
                    selected = 1
                end

            elseif key == keys.enter then
                local selectedFile = files[selected]

                config.bootFile = selectedFile
                saveConfig()

                writeLog("Boot Manager selected " .. selectedFile)

                clearScreen(C.black)

                centerText(5, "BOOTING", C.lightBlue)
                centerText(7, selectedFile, C.white)

                sleep(1)

                local ok = shell.run(selectedFile)

                if ok == false then
                    clearScreen(C.black)

                    centerText(5, "BOOT FAILED", C.red)
                    centerText(7, selectedFile, C.white)

                    pause()
                end

                return

            elseif key == keys.backspace then
                return
            end
        end
    end
end

-- ============================================================
-- FILE VIEWER
-- ============================================================

local function fileViewer(path)
    if not fs.exists(path) or fs.isDir(path) then
        return
    end

    local file = fs.open(path, "r")

    if not file then
        return
    end

    local data = file.readAll()
    file.close()

    local lines = {}

    for line in (data .. "\n"):gmatch("(.-)\r?\n") do
        lines[#lines + 1] = line
    end

    if #lines == 0 then
        lines[1] = ""
    end

    local top = 1

    while true do
        clearScreen(C.black)

        centerText(2, "FILE VIEWER", C.lightBlue)
        centerText(3, path, C.gray)
        separator(4)

        local _, h = getSize()
        local visible = h - 6

        for i = 1, visible do
            local index = top + i - 1
            local line = lines[index]

            if line then
                if #line > getSize() - 4 then
                    line = line:sub(1, getSize() - 4)
                end

                term.setCursorPos(3, 4 + i)
                safeText(C.white)
                write(line)
            end
        end

        term.setCursorPos(3, h - 1)
        safeText(C.gray)
        write("UP/DOWN=Scroll  BACKSPACE=Back")

        local event, key = os.pullEvent("key")

        if key == keys.up then
            top = top - 1

            if top < 1 then
                top = 1
            end

        elseif key == keys.down then
            if top < math.max(1, #lines - visible + 1) then
                top = top + 1
            end

        elseif key == keys.backspace then
            return
        end
    end
end

-- ============================================================
-- FILE MANAGER
-- ============================================================

local function fileManager()
    local current = "/"

    while true do
        local entries = fs.list(current)
        table.sort(entries)

        local selected = 1

        if #entries == 0 then
            selected = 0
        end

        while true do
            clearScreen(C.black)

            centerText(2, "MOON FILE MANAGER", C.lightBlue)
            centerText(3, current, C.gray)
            separator(4)

            local _, h = getSize()

            local visible = h - 7
            local first = math.max(1, selected - visible + 1)

            for i = first, math.min(#entries, first + visible - 1) do
                local y = 5 + (i - first)

                term.setCursorPos(3, y)

                if i == selected then
                    safeText(C.lime)
                    write("> ")
                else
                    safeText(C.white)
                    write("  ")
                end

                local name = entries[i]
                local fullPath = fs.combine(current, name)

                if fs.isDir(fullPath) then
                    safeText(C.cyan)
                    write("[DIR] " .. name)
                else
                    safeText(C.white)
                    write(name)
                end
            end

            term.setCursorPos(3, h - 2)
            safeText(C.gray)
            write("ENTER=Open  BACKSPACE=Back")

            term.setCursorPos(3, h - 1)
            write("R=Rename  D=Delete  N=New Folder")

            local event, key = os.pullEvent("key")

            if key == keys.up and #entries > 0 then
                selected = selected - 1

                if selected < 1 then
                    selected = #entries
                end

            elseif key == keys.down and #entries > 0 then
                selected = selected + 1

                if selected > #entries then
                    selected = 1
                end

            elseif key == keys.enter and selected > 0 then
                local name = entries[selected]
                local fullPath = fs.combine(current, name)

                if fs.isDir(fullPath) then
                    current = fullPath
                    break
                else
                    fileViewer(fullPath)
                    break
                end

            elseif key == keys.backspace then
                if current == "/" then
                    return
                end

                current = fs.getDir(current)

                if current == "" then
                    current = "/"
                end

                break

            elseif key == keys.r and selected > 0 then
                local oldName = entries[selected]
                local oldPath = fs.combine(current, oldName)

                clearScreen(C.black)

                centerText(3, "RENAME", C.lightBlue)

                term.setCursorPos(3, 6)
                safeText(C.white)
                write("New name: ")

                local newName = read()

                if newName and newName ~= "" then
                    local newPath = fs.combine(current, newName)

                    if not fs.exists(newPath) then
                        fs.move(oldPath, newPath)
                        writeLog("Renamed " .. oldPath .. " to " .. newPath)
                    end
                end

                break

            elseif key == keys.d and selected > 0 then
