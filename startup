-- ============================================================
-- POST
-- ============================================================

local function post()
    if not postEnabled then
        return true
    end

    bootBackground()

    print("================================================")
    print("                 MOON BIOS POST")
    print("================================================")
    print()

    local tests = {}

    -- CPU / core Lua test
    tests[#tests + 1] = {
        "CPU",
        function()
            return type(os.getComputerID) == "function"
        end
    }

    -- ========================================================
    -- FIXED MEMORY TEST
    -- ========================================================

    tests[#tests + 1] = {
        "Memory",
        function()
            local ok = pcall(function()

                local memoryTest = {}

                for i = 1, 128 do
                    memoryTest[i] =
                        string.rep(
                            "MOON",
                            512
                        )
                end

                -- Release the test memory
                memoryTest = nil

                -- Request garbage collection
                if type(collectgarbage) == "function" then
                    collectgarbage("collect")
                end
            end)

            return ok
        end
    }

    -- Filesystem
    tests[#tests + 1] = {
        "Filesystem",
        function()
            return fs ~= nil
                and type(fs.exists) == "function"
                and type(fs.open) == "function"
                and type(fs.list) == "function"
        end
    }

    -- Terminal
    tests[#tests + 1] = {
        "Terminal",
        function()
            return term ~= nil
                and type(term.clear) == "function"
                and type(term.setCursorPos) == "function"
                and type(term.getSize) == "function"
        end
    }

    -- Peripheral system
    tests[#tests + 1] = {
        "Peripherals",
        function()
            return peripheral ~= nil
                and type(peripheral.getNames) == "function"
        end
    }

    -- OS event system
    tests[#tests + 1] = {
        "Event System",
        function()
            return os ~= nil
                and type(os.pullEvent) == "function"
                and type(os.startTimer) == "function"
        end
    }

    -- Shell
    tests[#tests + 1] = {
        "Shell",
        function()
            return shell ~= nil
                and type(shell.run) == "function"
        end
    }

    -- Secure Boot
    if secureBoot then
        tests[#tests + 1] = {
            "Secure Boot",
            function()
                return hasCCSecureBoot()
                    or hasIntegrityRecord()
            end
        }
    end

    local allPassed = true

    for _, test in ipairs(tests) do
        local name = test[1]

        local ok, result =
            pcall(test[2])

        if ok and result then
            print("[ OK ] " .. name)
        else
            print("[FAIL] " .. name)
            allPassed = false
        end

        sleep(0.1)
    end

    print()

    if allPassed then
        print("POST COMPLETE")
    else
        print("POST COMPLETED WITH WARNINGS")
    end

    sleep(0.8)

    return allPassed
end

