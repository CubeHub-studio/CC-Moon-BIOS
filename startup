        end,

        function()
            local ok = testTerminal()

            header("Moon BIOS - Terminal Test")
            centerText(6, ok and "PASS" or "FAIL", ok and C.green or C.red)
            pause()
        end,

        function()
            local ok = testPeripherals()

            header("Moon BIOS - Peripheral Test")
            centerText(6, ok and "PASS" or "FAIL", ok and C.green or C.red)
            pause()
        end,

        graphicsTest,

        function()
            local ok = secureBootVerify(config.bootFile)

            header("Moon BIOS - Secure Boot Test")
            centerText(6, ok and "PASS" or "FAIL", ok and C.green or C.red)
            pause()
        end
    }

    local index = 1

    while true do
        header("Moon BIOS - Diagnostics")

        for i, option in ipairs(options) do
            term.setCursorPos(3, 3 + i)

            if i == index then
                term.setBackgroundColor(C.lightBlue)
                term.setTextColor(C.white)
            else
                term.setBackgroundColor(C.black)
                term.setTextColor(C.white)
            end

            term.clearLine()
            term.write(option)

            term.setBackgroundColor(C.black)
        end

        local event, key = os.pullEvent("key")

        if key == keys.up then
            index = index - 1

            if index < 1 then
                index = #options
            end

        elseif key == keys.down then
            index = index + 1

            if index > #options then
                index = 1
            end

        elseif key == keys.enter then
            if index == #options then
                return
            end

            functions[index]()

        elseif key == keys.backspace then
            return
        end
    end
end

-- ============================================================
-- BOOT FAILURE HANDLER
-- ============================================================

local function bootFailureScreen(message)
    config.bootFailureCount = (tonumber(config.bootFailureCount) or 0) + 1
    config.lastBootStatus = "FAILED"
    saveConfig()

    logBoot(
        "BOOT FAILED: " ..
        tostring(config.bootFile) ..
        " | " ..
        tostring(message)
    )

    logError(
        "Boot failure #" ..
        tostring(config.bootFailureCount) ..
        ": " ..
        tostring(message)
    )

    header("Moon BIOS - Boot Failure")

    centerText(4, "BOOT FAILED", C.red)
    centerText(6, config.bootFile, C.white)

    centerText(8, tostring(message), C.red)

    centerText(11, "ENTER = Recovery", C.yellow)
    centerText(12, "BACKSPACE = Boot Manager", C.gray)

    while true do
        local event, key = os.pullEvent("key")

        if key == keys.enter then
            recoveryMenu()
            return

        elseif key == keys.backspace then
            bootManager()
            return
        end
    end
end

-- ============================================================
-- BOOT PROCESS
-- ============================================================

local function attemptBoot()
    local path = config.bootFile

    if not fs.exists(path) then
        bootFailureScreen("Boot file not found")
        return false
    end

    if fs.isDir(path) then
        bootFailureScreen("Boot path is a directory")
        return false
    end

    if config.secureBoot then
        local secureOK = secureBootScreen(path)

        if not secureOK then
            if config.secureBootStrict then
                bootFailureScreen("Secure Boot rejected the boot file")
                return false
            end
        end
    end

    clearScreen(C.black)

    logBoot("Attempting boot: " .. path)

    local ok, result = pcall(function()
        return shell.run(path)
    end)

    if not ok then
        bootFailureScreen(result or "Unknown boot error")
        return false
    end

    if result == false then
        bootFailureScreen("Boot program returned failure")
        return false
    end

    config.bootFailureCount = 0
    config.lastBootStatus = "SUCCESS"

    saveConfig()

    logBoot("BOOT SUCCESS: " .. path)

    return true
end

-- ============================================================
-- BOOT INTERRUPT SCREEN
-- ============================================================

local function bootCountdown()
    if not config.autoBoot then
        return "bios"
    end

    if config.bootDelay <= 0 then
        return "boot"
    end

    local deadline = os.clock() + config.bootDelay

    while true do
        local remaining = math.ceil(deadline - os.clock())

        if remaining <= 0 then
            return "boot"
        end

        clearScreen(C.black)

        centerText(4, "MOON BIOS " .. VERSION, C.lightBlue)
        centerText(7, "Booting:", C.gray)
        centerText(8, config.bootFile, C.white)

        centerText(
            11,
            "Automatic boot in " .. tostring(remaining),
            C.white
        )

        centerText(14, "[1] BIOS", C.lightBlue)
        centerText(15, "[2] Boot Manager", C.lightBlue)
        centerText(16, "[3] Safe Mode", C.yellow)

        local timer = os.startTimer(0.1)

        while true do
            local event, a = os.pullEvent()

            if event == "timer" and a == timer then
                break

            elseif event == "key" then
                if a == keys.one then
                    return "bios"

                elseif a == keys.two then
                    return "bootmanager"

                elseif a == keys.three then
                    return "safe"
                end
            end
        end
    end
end

-- ============================================================
-- INITIALIZATION
-- ============================================================

loadConfig()

logEvent("Moon BIOS " .. VERSION .. " initialized")

logo()

-- Password protects manual BIOS access.
-- It does not interfere with the normal boot countdown.
local mode = bootCountdown()

if mode == "bios" then
    if passwordCheck() then
        mainMenu()
    end

elseif mode == "bootmanager" then
    if passwordCheck() then
        bootManager()
    end

elseif mode == "safe" then
    if passwordCheck() then
        safeMode()
    end

elseif mode == "boot" then
    if config.postEnabled then
        local passed = runPOST()

        if not passed and config.secureBootStrict then
            bootFailureScreen("POST failed while strict security is enabled")
        else
            attemptBoot()
        end
    else
        attemptBoot()
    end
end

-- ============================================================
-- FALLBACK
-- ============================================================

while true do
    header("Moon BIOS - Recovery")

    centerText(5, "Moon BIOS has returned from the boot program.", C.yellow)
    centerText(7, "The operating system has stopped.", C.gray)
    centerText(9, "ENTER = BIOS", C.lightBlue)

    waitEnter()

    if passwordCheck() then
        mainMenu()
    end
end
