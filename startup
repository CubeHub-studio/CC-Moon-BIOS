-- ============================================================
-- Moon BIOS 1.2
-- Complete Replacement BIOS
-- CC:Tweaked
--
-- Features:
--   * Original Moon crescent
--   * POST diagnostics
--   * Boot Manager
--   * Boot countdown
--   * Boot history
--   * Hardware information
--   * File Manager
--   * BIOS Settings
--   * Secure Boot / integrity checking
--   * Recovery tools
--   * Safe Mode
--   * CraftOS shell
--   * Graphics detection
--   * Monitor detection
--   * Disk detection
--   * Restart / shutdown
--
-- Controls:
--   ENTER     = Select
--   BACKSPACE = Back
--   UP/DOWN   = Navigate
--   1         = BIOS during boot
--   2         = Boot Manager during boot
--   3         = Safe Mode during boot
--
-- ESCAPE IS NOT USED.
-- ============================================================

local VERSION = "Moon BIOS 1.2"

local BOOT_FILE = "bootfile"
local CONFIG_FILE = "moonbios.cfg"
local SECURE_FILE = "moonbios.secure"
local LOG_FILE = "moonbios.log"
local HISTORY_FILE = "moonbios.history"

-- ============================================================
-- SAFE COLOR DEFINITIONS
-- ============================================================

local C = {
    black = colors.black,
    white = colors.white,
    gray = colors.gray,
    lightGray = colors.lightGray,
    lightBlue = colors.lightBlue,
    blue = colors.blue,
    cyan = colors.cyan,
    green = colors.green,
    lime = colors.lime,
    yellow = colors.yellow,
    orange = colors.orange,
    red = colors.red,
    magenta = colors.magenta,
    purple = colors.purple
}

-- ============================================================
-- DEFAULT CONFIGURATION
-- ============================================================

local config = {
    bootFile = BOOT_FILE,
    bootDelay = 5,
    autoBoot = true,
    postEnabled = true,
    safeMode = false,
    secureBoot = false,
    secureBootStrict = false
}

-- ============================================================
-- TERMINAL HELPERS
-- ============================================================

local function getSize()
    local w, h = term.getSize()

    if not w or w < 1 then
        w = 51
    end

    if not h or h < 1 then
        h = 19
    end

    return w, h
end

local function safeBackground(color)
    if color == nil then
        color = C.black
    end

    pcall(function()
        term.setBackgroundColor(color)
    end)
end

local function safeText(color)
    if color == nil then
        color = C.white
    end

    pcall(function()
        term.setTextColor(color)
    end)
end

local function clearScreen(bg)
    safeBackground(bg or C.black)
    safeText(C.white)
    term.clear()
    term.setCursorPos(1, 1)
end

local function centerText(y, text, color)
    local w = getSize()
    text = tostring(text or "")

    if #text > w then
        text = text:sub(1, w)
    end

    local x = math.floor((w - #text) / 2) + 1

    if x < 1 then
        x = 1
    end

    term.setCursorPos(x, y)
    safeText(color or C.white)
    write(text)
end

local function separator(y)
    local w = getSize()

    term.setCursorPos(1, y)
    safeText(C.gray)
    write(string.rep("-", w))
end

local function waitForKey()
    while true do
        local event, key = os.pullEvent("key")

        if key == keys.enter or key == keys.backspace then
            return key
        end
    end
end

local function pause(message)
    local _, h = getSize()

    term.setCursorPos(1, h)
    safeText(C.gray)

    if message then
        write(message)
    else
        write("Press ENTER to continue.")
    end

    while true do
        local event, key = os.pullEvent("key")

        if key == keys.enter then
            return
        end
    end
end

local function yesNo(default)
    local selected = default ~= false

    while true do
        clearScreen(C.black)

        centerText(3, "Confirm", C.lightBlue)

        term.setCursorPos(8, 6)

        if selected then
            safeText(C.lime)
            write("> YES")
            safeText(C.white)
            term.setCursorPos(8, 7)
            write("  NO")
        else
            safeText(C.white)
            write("  YES")
            term.setCursorPos(8, 7)
            safeText(C.lime)
            write("> NO")
        end

        local event, key = os.pullEvent("key")

        if key == keys.up or key == keys.down then
            selected = not selected
        elseif key == keys.enter then
            return selected
        elseif key == keys.backspace then
            return false
        end
    end
end

-- ============================================================
-- LOGGING
-- ============================================================

local function timestamp()
    local ok, result = pcall(function()
        return textutils.formatTime(os.time(), true)
    end)

    if ok and result then
        return result
    end

    return "TIME"
end

local function writeLog(message)
    local ok = pcall(function()
        local file = fs.open(LOG_FILE, "a")

        if file then
            file.writeLine(
                "[" .. timestamp() .. "] " .. tostring(message)
            )

            file.close()
        end
    end)

    return ok
end

local function writeHistory(message)
    pcall(function()
        local file = fs.open(HISTORY_FILE, "a")

        if file then
            file.writeLine(
                "[" .. timestamp() .. "] " .. tostring(message)
            )

            file.close()
        end
    end)
end

-- ============================================================
-- CONFIGURATION
-- ============================================================

local function saveConfig()
    local ok = pcall(function()
        local file = fs.open(CONFIG_FILE, "w")

        if not file then
            error("Unable to open configuration file.")
        end

        file.write(textutils.serialize(config))
        file.close()
    end)

    if ok then
        writeLog("Configuration saved.")
    else
        writeLog("Configuration save failed.")
    end

    return ok
end

local function loadConfig()
    if not fs.exists(CONFIG_FILE) then
        saveConfig()
        return
    end

    local ok, data = pcall(function()
        local file = fs.open(CONFIG_FILE, "r")

        if not file then
            error("Unable to open configuration.")
        end

        local contents = file.readAll()
        file.close()

        return textutils.unserialize(contents)
    end)

    if ok and type(data) == "table" then
        for key, value in pairs(data) do
            if config[key] ~= nil then
                config[key] = value
            end
        end
    else
        writeLog("Invalid configuration detected. Using defaults.")
        saveConfig()
    end

    if type(config.bootDelay) ~= "number" then
        config.bootDelay = 5
    end

    if config.bootDelay < 0 then
        config.bootDelay = 0
    end

    if config.bootDelay > 30 then
        config.bootDelay = 30
    end

    if type(config.bootFile) ~= "string" or config.bootFile == "" then
        config.bootFile = BOOT_FILE
    end
end

