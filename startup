-- ============================================================
-- SECURE BOOT
-- ============================================================

local function findCodeSign()
    local path = "/rom/modules/main/codesign.lua"

    if fs.exists(path) then
        return path
    end

    return nil
end

local function secureBootAvailable()
    return findCodeSign() ~= nil
end

local function simpleIntegrity(path)
    if not fs.exists(path) or fs.isDir(path) then
        return nil
    end

    local file = fs.open(path, "r")

    if not file then
        return nil
    end

    local data = file.readAll()
    file.close()

    local hash = 2166136261

    for i = 1, #data do
        hash = bit32.bxor(hash, string.byte(data, i))
        hash = (hash * 16777619) % 4294967296
    end

    return string.format("%08x", hash)
end

local function secureBootVerify(path)
    if not config.secureBoot then
        return true, "Secure Boot disabled."
    end

    if not fs.exists(path) then
        return false, "Boot file does not exist."
    end

    local codeSignPath = findCodeSign()

    if codeSignPath then
        local ok, result = pcall(function()
            local codesign = dofile(codeSignPath)

            if type(codesign) ~= "table" then
                error("Invalid codesign module.")
            end

            if type(codesign.verify) ~= "function" then
                error("Verification function unavailable.")
            end

            return codesign.verify(path)
        end)

        if ok and result then
            return true, "CC Secure Boot verification passed."
        end

        if config.secureBootStrict then
            return false, "CC Secure Boot verification failed."
        end
    end

    local checksum = simpleIntegrity(path)

    if not checksum then
        return false, "Unable to calculate file integrity."
    end

    if not fs.exists(SECURE_FILE) then
        if config.secureBootStrict then
            return false, "No integrity database exists."
        end

        return true, "Integrity database not configured."
    end

    local file = fs.open(SECURE_FILE, "r")

    if not file then
        return false, "Unable to read integrity database."
    end

    local database = file.readAll()
    file.close()

    local expected = nil

    for line in database:gmatch("[^\r\n]+") do
        local savedPath, savedHash = line:match("^(.-)|(.+)$")

        if savedPath == path then
            expected = savedHash
            break
        end
    end

    if not expected then
        if config.secureBootStrict then
            return false, "Boot file is not in the integrity database."
        end

        return true, "Boot file has no stored integrity record."
    end

    if expected == checksum then
        return true, "Integrity verification passed."
    end

    return false, "Integrity verification FAILED."
end

local function secureBootDatabase()
    clearScreen(C.black)

    centerText(2, "SECURE BOOT DATABASE", C.lightBlue)
    separator(3)

    local filePath = config.bootFile

    if not fs.exists(filePath) then
        term.setCursorPos(3, 5)
        safeText(C.red)
        write("Boot file does not exist.")

        pause()
        return
    end

    local checksum = simpleIntegrity(filePath)

    if not checksum then
        term.setCursorPos(3, 5)
        safeText(C.red)
        write("Unable to calculate integrity.")

        pause()
        return
    end

    local file = fs.open(SECURE_FILE, "w")

    if file then
        file.writeLine(filePath .. "|" .. checksum)
        file.close()

        writeLog("Created secure integrity record for " .. filePath)

        term.setCursorPos(3, 5)
        safeText(C.green)
        write("Integrity record created.")

        term.setCursorPos(3, 7)
        safeText(C.white)
        write("File: " .. filePath)

        term.setCursorPos(3, 8)
        write("Hash: " .. checksum)
    else
        term.setCursorPos(3, 5)
        safeText(C.red)
        write("Could not create database.")
    end

    pause()
end

-- ============================================================
-- POST
-- ============================================================

local function runPOST()
    if not config.postEnabled then
        return true
    end

    clearScreen(C.black)

    centerText(2, "MOON BIOS POWER-ON SELF TEST", C.lightBlue)
    separator(3)

    local tests = {
        {
            "CPU / Computer",
            function()
                return os.getComputerID() ~= nil
            end
        },
        {
            "Memory",
            testMemory
        },
        {
            "Filesystem",
            testFilesystem
        },
        {
            "Terminal",
            testTerminal
        },
        {
            "Peripherals",
            testPeripherals
        },
        {
            "Event System",
            testEvents
        },
        {
            "Shell",
            testShell
        },
        {
            "Secure Boot",
            function()
                if not config.secureBoot then
                    return true
                end

                local ok = secureBootVerify(config.bootFile)

                return ok
            end
        }
    }

    local allPassed = true
    local y = 5

    for _, test in ipairs(tests) do
        if y >= getSize() - 3 then
            break
        end

        term.setCursorPos(3, y)
        safeText(C.white)
        write(test[1] .. string.rep(" ", 20 - math.min(#test[1], 20)))

        local ok, result = pcall(test[2])

        local passed = ok and result

        if passed then
            safeText(C.green)
            write("[ OK ]")
        else
            safeText(C.red)
            write("[FAIL]")
            allPassed = false
        end

        y = y + 1
    end

    y = y + 1

    term.setCursorPos(3, y)

    if allPassed then
        safeText(C.green)
        write("POST COMPLETE - ALL TESTS PASSED")
        writeLog("POST passed.")
    else
        safeText(C.yellow)
        write("POST COMPLETE - ONE OR MORE TESTS FAILED")
        writeLog("POST reported one or more failures.")
    end

    sleep(1.5)

    return allPassed
end

