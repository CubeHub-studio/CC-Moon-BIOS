-- HARDWARE DETECTION
-- ============================================================

local function getComputerType()
    local ok, result = pcall(os.getComputerLabel)

    if ok and result then
        return result
    end

    return "Computer"
end

local function hardwareInfo()
    clearScreen(C.black)

    centerText(2, "HARDWARE INFORMATION", C.lightBlue)
    separator(3)

    local w, h = getSize()
    local y = 5

    local info = {
        "Computer ID: " .. tostring(os.getComputerID()),
        "Computer Label: " .. tostring(getComputerType()),
        "Terminal Width: " .. tostring(w),
        "Terminal Height: " .. tostring(h),
        "ComputerCraft: " .. tostring(_HOST or "Unknown"),
        "Lua Version: " .. tostring(_VERSION or "Unknown")
    }

    local okVersion, version = pcall(function()
        return os.version()
    end)

    if okVersion and version then
        info[#info + 1] = "OS Version: " .. tostring(version)
    end

    for _, line in ipairs(info) do
        if y < h - 3 then
            term.setCursorPos(3, y)
            safeText(C.white)
            write(line)
            y = y + 1
        end
    end

    y = y + 1

    if y < h - 2 then
        safeText(C.cyan)
        term.setCursorPos(3, y)
        write("Peripherals:")

        y = y + 1

        local peripherals = peripheral.getNames()

        if #peripherals == 0 then
            term.setCursorPos(5, y)
            safeText(C.gray)
            write("None detected.")
        else
            for _, name in ipairs(peripherals) do
                if y < h - 2 then
                    local pType = peripheral.getType(name) or "unknown"

                    term.setCursorPos(5, y)
                    safeText(C.white)
                    write(name .. " (" .. pType .. ")")

                    y = y + 1
                end
            end
        end
    end

    pause()
end

