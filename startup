    )
end

-- ============================================================
-- RUN BOOT FILE
-- ============================================================

local function runBootFile(path)
    bootBackground()

    if not fs.exists(path) then
        bootError(
            "BOOT ERROR",
            "Boot file not found:\n" .. path
        )

        return false
    end

    if fs.isDir(path) then
        bootError(
            "BOOT ERROR",
            path .. " is a directory."
        )

        return false
    end

    -- Secure Boot
    if secureBoot then
        local verified, message =
            verifySecureBoot(path)

        if not verified then
            bootError(
                "SECURE BOOT FAILURE",
                message
                .. "\n\nFile: "
                .. path
            )

            return false
        end
    end

    -- Safe Mode information
    if safeMode then
        bootBackground()

        print("Moon BIOS")
        print()
        print("SAFE MODE")
        print()
        print("Booting:")
        print(path)
        print()
        print("Safe Mode is active.")
        sleep(0.7)
    end

    -- Run the program normally through CraftOS shell.
    local ok, result = pcall(
        function()
            return shell.run(path)
        end
    )

    if not ok then
        bootError(
            "BOOT RUNTIME ERROR",
            tostring(result)
        )

        return false
    end

    if result == false then
        bootError(
            "BOOT FAILURE",
            "The boot program reported failure."
        )

        return false
    end

    return true
end

-- ============================================================
-- BOOT MANAGER
-- ============================================================

bootManager = function()
    while true do
        biosBackground()

        print("================================================")
        print("                  BOOT MANAGER")
        print("================================================")
        print()

        print("Selected boot target:")
        print("  " .. bootFile)
        print()

        if fs.exists(bootFile) then
            print("Status: FOUND")
        else
            print("Status: NOT FOUND")
        end

        print()

        print("1. Boot selected file")
        print("2. Change boot file")
        print("3. Boot Safe Mode")
        print("4. Recovery")
        print("5. Back")
        print()

        local _, key = os.pullEvent("key")

        if key == keys.one then

            local oldSafeMode = safeMode

            safeMode = false
            runBootFile(bootFile)

            safeMode = oldSafeMode

        elseif key == keys.two then

            chooseBootFile()

        elseif key == keys.three then

            local oldSafeMode = safeMode

            safeMode = true
            runBootFile(bootFile)

            safeMode = oldSafeMode

        elseif key == keys.four then

            recoveryMenu()

        elseif key == keys.five then

            return
        end
    end
end

-- ============================================================
-- FILE MANAGER
-- ============================================================

fileManager = function()
    while true do
        biosBackground()

        print("================================================")
        print("                 FILE MANAGER")
        print("================================================")
        print()

        local files = fs.list("/")

        if #files == 0 then
            print("No files found.")
        else

            for _, file in ipairs(files) do

                if file ~= "startup"
                    and file ~= "startup.lua" then

                    if fs.isDir("/" .. file) then
                        print("[DIR ] " .. file)
                    else
                        print("[FILE] " .. file)
                    end
                end
            end
        end

        print()
        print("Press:")
        print("  R = Run a file")
        print("  D = Delete a file")
        print("  B = Back")
        print()

        local _, key = os.pullEvent("key")

        if key == keys.r then

            write("File to run: ")

            local path = trim(read())

            if path ~= "" then
                runBootFile(path)
            end

        elseif key == keys.d then

            write("File to delete: ")

            local path = trim(read())

            if path ~= ""
                and path ~= "startup"
                and path ~= "startup.lua" then

                if fs.exists(path) then
                    fs.delete(path)

                    print()
                    print("Deleted.")
                    sleep(0.5)
                end
            end

        elseif key == keys.b
            or key == keys.escape then

            return
        end
    end
end

