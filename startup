    }

    for i,s in ipairs(data) do
        term.setCursorPos(3,4+i)
        write(s)
    end

    pause()
end

-- ============================================================
-- FILE VIEWER
-- ============================================================

local function view(path)
    local f=fs.open(path,"r")
    if not f then return end

    local lines={}
    for line in f.readAll():gmatch("[^\r\n]+") do
        lines[#lines+1]=line
    end
    f.close()

    local top=1

    while true do
        clear()
        center(2,path,C.lightBlue)

        local _,h=term.getSize()

        for i=1,h-5 do
            local line=lines[top+i-1]

            if line then
                term.setCursorPos(2,3+i)
                write(line:sub(1,term.getSize()-3))
            end
        end

        center(h,"UP/DOWN Scroll | BACKSPACE Back",C.gray)

        local e,k=os.pullEvent("key")

        if k==keys.up then
            top=math.max(1,top-1)

        elseif k==keys.down then
            top=math.min(math.max(1,#lines-h+6),top+1)

        elseif k==keys.backspace then
            return
        end
    end
end

-- ============================================================
-- FILE MANAGER
-- ============================================================

local function files()
    local dir="/"

    while true do
        local list=fs.list(dir)
        table.sort(list)

        local selected=1

        while true do
            clear()
            center(2,"FILE MANAGER",C.lightBlue)
            center(3,dir,C.gray)

            for i,name in ipairs(list) do
                term.setCursorPos(3,4+i)

                if i==selected then
                    term.setTextColor(C.lime)
                    write("> ")
                else
                    term.setTextColor(C.white)
                    write("  ")
                end

                if fs.isDir(fs.combine(dir,name)) then
                    term.setTextColor(C.cyan)
                    write("[DIR] "..name)
                else
                    write(name)
                end
            end

            local _,h=term.getSize()
            center(h,"ENTER Open | BACKSPACE Back",C.gray)

            local e,k=os.pullEvent("key")

            if k==keys.up and #list>0 then
                selected=selected-1
                if selected<1 then selected=#list end

            elseif k==keys.down and #list>0 then
                selected=selected+1
                if selected>#list then selected=1 end

            elseif k==keys.enter and list[selected] then
                local p=fs.combine(dir,list[selected])

                if fs.isDir(p) then
                    dir=p
                    break
                else
                    view(p)
                    break
                end

            elseif k==keys.backspace then
                if dir=="/" then return end

                dir=fs.getDir(dir)

                if dir=="" then dir="/" end

                break
            end
        end
    end
end

-- ============================================================
-- BOOT MANAGER
-- ============================================================

local function bootManager()
    local list={}

    for _,name in ipairs(fs.list("/")) do
        if not fs.isDir(name) then
            if name=="bootfile"
            or name=="startup"
            or name:match("^boot")
            or name:match("%.lua$") then
                list[#list+1]=name
            end
        end
    end

    table.sort(list)

    if #list==0 then
        clear()
        center(5,"NO BOOT FILES FOUND",C.yellow)
        pause()
        return
    end

    local selected=1

    while true do
        clear()
        center(2,"BOOT MANAGER",C.lightBlue)

        for i,name in ipairs(list) do
            term.setCursorPos(4,4+i)

            if i==selected then
                term.setTextColor(C.lime)
                write("> "..name)
            else
                term.setTextColor(C.white)
                write("  "..name)
            end
        end

        local _,h=term.getSize()
        center(h,"ENTER Boot | BACKSPACE Back",C.gray)

        local e,k=os.pullEvent("key")

        if k==keys.up then
            selected=selected-1
            if selected<1 then selected=#list end

        elseif k==keys.down then
            selected=selected+1
            if selected>#list then selected=1 end

        elseif k==keys.enter then
            cfg.bootFile=list[selected]
            save()

            local ok=verify(cfg.bootFile)

            if not ok then
                clear()
                center(5,"SECURE BOOT BLOCKED",C.red)
                pause()
                return
            end

            shell.run(cfg.bootFile)
            return

        elseif k==keys.backspace then
            return
        end
    end
end

-- ============================================================
-- SETTINGS
-- ============================================================

local function settings()
    local selected=1

    while true do
        local list={
            "Boot File: "..cfg.bootFile,
            "Boot Delay: "..cfg.bootDelay,
            "Auto Boot: "..(cfg.autoBoot and "ON" or "OFF"),
            "POST: "..(cfg.post and "ON" or "OFF"),
            "Safe Mode: "..(cfg.safe and "ON" or "OFF"),
            "Secure Boot: "..(cfg.secure and "ON" or "OFF"),
            "Strict Secure Boot: "..(cfg.strict and "ON" or "OFF"),
            "Create Integrity Record",
            "Back"
        }

        clear()
        center(2,"BIOS SETTINGS",C.lightBlue)

        for i,s in ipairs(list) do
            term.setCursorPos(3,4+i)

            if i==selected then
                term.setTextColor(C.lime)
                write("> "..s)
            else
                term.setTextColor(C.white)
                write("  "..s)
            end
        end

        local e,k=os.pullEvent("key")

        if k==keys.up then
            selected=selected-1
            if selected<1 then selected=#list end

        elseif k==keys.down then
            selected=selected+1
            if selected>#list then selected=1 end

        elseif k==keys.backspace then
            return

        elseif k==keys.enter then

            if selected==1 then
                clear()
                center(3,"BOOT FILE",C.lightBlue)
                term.setCursorPos(3,6)
                write("File: ")
                local v=read()

                if v and v~="" then
                    cfg.bootFile=v
                    save()
                end

            elseif selected==2 then
                clear()
                center(3,"BOOT DELAY",C.lightBlue)
                term.setCursorPos(3,6)
                write("Seconds 0-30: ")

                local v=tonumber(read())

                if v then
                    cfg.bootDelay=math.max(0,math.min(30,math.floor(v)))
                    save()
                end

            elseif selected==3 then
                cfg.autoBoot=not cfg.autoBoot
                save()

            elseif selected==4 then
                cfg.post=not cfg.post
                save()

            elseif selected==5 then
                cfg.safe=not cfg.safe
                save()

            elseif selected==6 then
                cfg.secure=not cfg.secure
                save()

            elseif selected==7 then
                cfg.strict=not cfg.strict
                save()

            elseif selected==8 then
                makeSecure()

            elseif selected==9 then
                return
            end
        end
    end
end

-- ============================================================
-- RECOVERY
-- ============================================================

local function recovery()
    local selected=1

    while true do
        local list={
            "Safe Mode",
            "CraftOS Shell",
            "File Manager",
            "Boot Manager",
            "Diagnostics",
            "Restart",
            "Shutdown",
            "Back"
        }

        clear()
        center(2,"RECOVERY",C.lightBlue)

        for i,s in ipairs(list) do
            term.setCursorPos(4,4+i)

            if i==selected then
                term.setTextColor(C.lime)
                write("> "..s)
            else
                term.setTextColor(C.white)
                write("  "..s)
            end
        end

        local e,k=os.pullEvent("key")

        if k==keys.up then
            selected=selected-1
            if selected<1 then selected=#list end

        elseif k==keys.down then
            selected=selected+1
            if selected>#list then selected=1 end

        elseif k==keys.backspace then
            return

        elseif k==keys.enter then
            if selected==1 then
                cfg.safe=true
                safeMode()
                return

            elseif selected==2 then
                shell.run("shell")

            elseif selected==3 then
                files()

            elseif selected==4 then
                bootManager()

            elseif selected==5 then
                post()
                pause()

            elseif selected==6 then
                os.reboot()

            elseif selected==7 then
                os.shutdown()

            elseif selected==8 then
                return
            end
        end
    end
end

-- ============================================================
-- SAFE MODE
-- ============================================================

function safeMode()
    while true do
        clear()
        center(2,"MOON BIOS SAFE MODE",C.yellow)

        center(5,"Normal boot disabled.",C.white)

        local list={
            "CraftOS Shell",
            "Boot Manager",
            "File Manager",
            "Diagnostics",
            "Restart",
            "Shutdown"
        }

        local selected=1

        while true do
            for i,s in ipairs(list) do
                term.setCursorPos(5,6+i)

                if i==selected then
                    term.setTextColor(C.lime)
                    write("> "..s)
                else
                    term.setTextColor(C.white)
                    write("  "..s)
                end
            end

            local e,k=os.pullEvent("key")

            if k==keys.up then
                selected=selected-1
                if selected<1 then selected=#list end

            elseif k==keys.down then
                selected=selected+1
                if selected>#list then selected=1 end

            elseif k==keys.enter then
                if selected==1 then
                    shell.run("shell")
                    clear()

                elseif selected==2 then
                    bootManager()
                    return

                elseif selected==3 then
                    files()
                    clear()

                elseif selected==4 then
                    post()
                    pause()
                    clear()

                elseif selected==5 then
                    os.reboot()

                elseif selected==6 then
                    os.shutdown()
                end

                break
            end
        end
    end
end

-- ============================================================
-- DIAGNOSTICS
-- ============================================================

local function diagnostics()
    clear()
    center(2,"DIAGNOSTICS",C.lightBlue)

    local y=5

    local function check(name,fn)
        term.setCursorPos(3,y)
        write(name)

        local ok,res=pcall(fn)

        if ok and res then
            term.setTextColor(C.green)
            write(" [ OK ]")
        else
            term.setTextColor(C.red)
            write(" [FAIL]")
        end

        y=y+1
    end

    check("Filesystem",function()
        local p=".diag"
        local f=fs.open(p,"w")
        if not f then return false end
        f.write("1")
        f.close()
        fs.delete(p)
        return true
    end)

    check("Terminal",function()
        return term.getSize()~=nil
    end)

    check("Peripherals",function()
        peripheral.getNames()
        return true
    end)

    check("Secure Boot",function()
        return verify(cfg.bootFile)
    end)

    check("Graphics API",function()
        return term.setGraphicsMode~=nil
    end)

    pause()
end

