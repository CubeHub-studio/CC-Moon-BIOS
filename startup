local V = "Moon BIOS 1.2 Compact"
local BOOT = "bootfile"
local CFG = "moonbios.cfg"
local SEC = "moonbios.secure"
local LOG = "moonbios.log"

local C = colors

local cfg = {
    bootFile = BOOT,
    bootDelay = 5,
    autoBoot = true,
    post = true,
    safe = false,
    secure = false,
    strict = false
}

-- ============================================================
-- BASIC FUNCTIONS
-- ============================================================

local function clear(bg)
    term.setBackgroundColor(bg or C.black)
    term.setTextColor(C.white)
    term.clear()
    term.setCursorPos(1,1)
end

local function center(y,s,c)
    local w = term.getSize()
    s = tostring(s)
    term.setCursorPos(math.max(1,math.floor((w-#s)/2)+1),y)
    term.setTextColor(c or C.white)
    write(s)
end

local function log(s)
    pcall(function()
        local f=fs.open(LOG,"a")
        if f then
            f.writeLine(s)
            f.close()
        end
    end)
end

local function save()
    local f=fs.open(CFG,"w")
    if f then
        f.write(textutils.serialize(cfg))
        f.close()
    end
end

local function load()
    if not fs.exists(CFG) then
        save()
        return
    end

    local ok,data=pcall(function()
        local f=fs.open(CFG,"r")
        local d=f.readAll()
        f.close()
        return textutils.unserialize(d)
    end)

    if ok and type(data)=="table" then
        for k,v in pairs(data) do
            if cfg[k]~=nil then cfg[k]=v end
        end
    else
        save()
    end

    if type(cfg.bootFile)~="string" or cfg.bootFile=="" then
        cfg.bootFile=BOOT
    end

    if type(cfg.bootDelay)~="number" then
        cfg.bootDelay=5
    end

    cfg.bootDelay=math.max(0,math.min(30,math.floor(cfg.bootDelay)))
end

local function pause()
    center(select(2,term.getSize()),"ENTER = Continue",C.gray)
    while true do
        local e,k=os.pullEvent("key")
        if k==keys.enter then return end
    end
end

